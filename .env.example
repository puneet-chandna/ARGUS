# App and hosted persistence
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Leave empty for local development. Set the exact browser origin for deployment.
ARGUS_PUBLIC_ORIGIN=

# Optional OCR keys. Use free provider access and authorized documents.
NVIDIA_API_KEY=
SARVAM_API_KEY=
# This key also enables DeepSeek V4.1 Flash 1017 as the independent-reader fallback.
# Both Sarvam routes require available account credits/quota.
GEMINI_API_KEY=
ARGUS_NVIDIA_ENDPOINT=
ARGUS_OCR_PAGES_PER_RUN=20
ARGUS_OCR_CACHE_DIR=
ARGUS_WRITE_OCR_CACHE=0

# Optional: at least 32 random characters; set only with a scheduled POST /api/maintenance.
ARGUS_MAINTENANCE_SECRET=
