# Local instructions, notes, caches, and secrets
/AGENTS.md
/docs/*
!/docs/assets/
!/docs/development.md
/notes/
/.local/
.env
.env.*
!.env.example
/uploads/

# Official inputs are downloaded from Vaatun and checked against this manifest.
/vaatun-starter-bundle/*
!/vaatun-starter-bundle/MANIFEST.json

# Local prototype, benchmarks, and rate-card import tooling
/argus/
/evals/
/tests/
/requirements*.txt
/scripts/*.py
!/scripts/import-tata-card.py

# Generated files
/node_modules/
/test-results/
/playwright-report/
/var/cache/fontconfig/
/.next/
/next-env.d.ts
*.tsbuildinfo
/supabase/.temp/
/.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
